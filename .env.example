VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Only for real integration tests; put these in .env.test.local.
# Use a dedicated, confirmed Supabase test user. Never prefix these with VITE_.
E2E_EMAIL=
E2E_PASSWORD=
# Optional: a deployed frontend URL (otherwise Playwright starts Vite locally).
E2E_BASE_URL=
